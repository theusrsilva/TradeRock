+@contextlib.contextmanager
+def rx_monitor(phy, log=print):
+    """Hold a monitor vif up on `phy` while the station is joined.
+
+    The host's advertisements -- where our participant slot and IP come from --
+    are action frames sent to ff:ff:ff:ff:ff:ff with a BSSID (addr3) of
+    ff:ff:ff:ff:ff:ff, not the host's own address. Some drivers (mt76x0u, the
+    ALFA AWUS036ACHM) filter "not my BSSID" in hardware while a plain station
+    is associated, so after joining NOT ONE advertisement arrives: the auth
+    exchange (unicast) works, then the join times out with no IP. A running
+    monitor vif makes mac80211 ask the driver for other-BSS frames, which
+    lifts that filter. FRLG_RX_MONITOR=0 disables it."""
+    if os.environ.get("FRLG_RX_MONITOR", "1") == "0":
+        yield
+        return
+    _iw_del(RX_MONITOR_VIF)
+    subprocess.run(["iw", "phy", phy, "interface", "add", RX_MONITOR_VIF, "type", "monitor"],
+                   check=False, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
+    up = subprocess.run(["ip", "link", "set", RX_MONITOR_VIF, "up"], check=False,
+                        stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL).returncode == 0
+    log(f"[live] rx monitor {RX_MONITOR_VIF} on {phy}: "
+        f"{'up (other-BSS frames enabled)' if up else 'FAILED to come up'}")
+    try:
+        yield
+    finally:
+        _iw_del(RX_MONITOR_VIF)
+
