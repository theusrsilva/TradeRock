+def _looks_like_frlg_beacon(app_data):
+    """True if an advertisement's application data has the FRLG RFU search-beacon shape: the 0x5C
+    Pia header followed by exactly 30 characters of the RFU base85 alphabet (a 24-byte record) whose
+    host name decodes in the FRLG character set. Lets a console be recognised by what it advertises
+    when its local_communication_id is one we have not seen (it differs by region/app version)."""
+    app_data = bytes(app_data or b"")
+    gba = app_data[_PIA_HDR:]
+    if len(app_data) < _PIA_HDR or len(gba) != 30:
+        return False
+    if any(c < 0x23 or c > 0x78 or c == 0x5C for c in gba):
+        return False
+    name = _b85_decode(gba)[2:10]
+    return bool(name) and name[0] != 0xFF and "?" not in _frlg_name(name)
+
+
