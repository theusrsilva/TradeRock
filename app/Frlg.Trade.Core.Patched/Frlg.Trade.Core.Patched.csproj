<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Núcleo C# do easyworld (engines/frlg-ldn-trade-esp32/host/core, AGPL-3.0) com os patches do
    TradeRock (engines/patches/frlg-ldn-trade-esp32). O submódulo fica intocado: a cada build, as
    fontes são copiadas para obj/ e recebem os patches (patch -p1), como o motor Python (D15, D18).
  -->
  <PropertyGroup>
    <RootNamespace>Frlg.Trade.Core</RootNamespace>
    <AssemblyName>Frlg.Trade.Core</AssemblyName>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <!-- Código de terceiros: avisos dele não quebram o build do TradeRock. -->
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <NoWarn>$(NoWarn);CS8600;CS8601;CS8602;CS8603;CS8604;CS8618;CS8625;CS0168;CS0219;CS0414</NoWarn>
    <UpstreamDir>$(MSBuildThisFileDirectory)../../engines/frlg-ldn-trade-esp32/host/core/</UpstreamDir>
    <PatchDir>$(MSBuildThisFileDirectory)../../engines/patches/frlg-ldn-trade-esp32/</PatchDir>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BouncyCastle.Cryptography" />
    <PackageReference Include="ZstdSharp.Port" />
    <PackageReference Include="System.IO.Ports" />
    <PackageReference Include="PKHeX.Core" />
  </ItemGroup>

  <ItemGroup>
    <UpstreamSource Include="$(UpstreamDir)*.cs" />
    <EnginePatch Include="$(PatchDir)*.patch" />
    <InternalsVisibleTo Include="TradeRock.Tests" />
  </ItemGroup>

  <!-- IntermediateOutputPath só existe depois da avaliação do projeto: calculado num target. -->
  <Target Name="ComputePatchedDir">
    <PropertyGroup>
      <PatchedDir>$(MSBuildProjectDirectory)/$(IntermediateOutputPath)patched/</PatchedDir>
    </PropertyGroup>
  </Target>

  <Target Name="ApplyEnginePatches" BeforeTargets="CoreCompile" DependsOnTargets="ComputePatchedDir" Inputs="@(UpstreamSource);@(EnginePatch)" Outputs="$(PatchedDir).applied">
    <Error Condition="'@(UpstreamSource)' == ''" Text="Fontes do easyworld ausentes: rode git submodule update --init --recursive." />
    <RemoveDir Directories="$(PatchedDir)" />
    <Copy SourceFiles="@(UpstreamSource)" DestinationFolder="$(PatchedDir)" />
    <Exec Command="patch -p1 --forward --quiet -d &quot;$(PatchedDir)&quot; -i &quot;%(EnginePatch.FullPath)&quot;" />
    <Touch Files="$(PatchedDir).applied" AlwaysCreate="true" />
  </Target>

  <Target Name="IncludePatchedSources" BeforeTargets="CoreCompile" DependsOnTargets="ComputePatchedDir;ApplyEnginePatches">
    <ItemGroup>
      <Compile Include="$(PatchedDir)*.cs" />
    </ItemGroup>
  </Target>
</Project>
