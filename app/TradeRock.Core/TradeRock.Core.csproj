<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>TradeRock.Core</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="TradeRock.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="PKHeX.Core" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" />
    <PackageReference Include="System.IO.Ports" />
    <PackageReference Include="System.Management" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" PrivateAssets="all" />
  </ItemGroup>

  <!-- PKHeX.Core.AutoMod (santacrab2/PKHeX-Plugins, MIT), do submódulo: não é publicado no NuGet. -->
  <ItemGroup>
    <ProjectReference Include="..\..\engines\PKHeX-Plugins\PKHeX.Core.AutoMod\PKHeX.Core.AutoMod.csproj" />
  </ItemGroup>

  <!-- Traduções das mensagens do PKHeX (content/<idioma>/pkhex) e dados do construtor. -->
  <ItemGroup>
    <EmbeddedResource Include="..\..\content\pt-BR\pkhex\*.json" LogicalName="pkhex/pt-BR/%(Filename)%(Extension)" />
    <EmbeddedResource Include="Builder\Data\unverifiable.json" LogicalName="builder/unverifiable.json" />
    <EmbeddedResource Include="..\..\catalog\hardware-catalog.json" LogicalName="catalog/hardware-catalog.json" />
    <EmbeddedResource Include="..\..\catalog\gifts.json" LogicalName="catalog/gifts.json" />
    <EmbeddedResource Include="..\..\catalog\raids.json" LogicalName="catalog/raids.json" />
    <EmbeddedResource Include="..\..\packaging\linux\worker-setup.sh" LogicalName="worker-setup.sh" />
  </ItemGroup>

  <!-- Firmware do ESP32: o do pokeldn para todos os jogos (D23), de scripts/fetch-pokeldn-firmware.sh. -->
  <ItemGroup>
    <EmbeddedResource Include="..\..\assets\firmware\pokeldn\*.bin" LogicalName="firmware/%(Filename)%(Extension)" />
    <EmbeddedResource Include="..\..\assets\firmware\pokeldn\SHA256SUMS.txt" LogicalName="firmware/SHA256SUMS.txt" />
  </ItemGroup>

  <!-- Pokémon de demonstração (modo demonstração e testes). -->
  <ItemGroup>
    <EmbeddedResource Include="..\..\assets\demo\*.pk3" LogicalName="demo/%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
